{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Pyramid API — NestJS + MongoDB service exposing the workspace, project and task domains.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "//build": "tsc leaves the @pyramid/* path aliases in place; tsc-alias rewrites them to relative paths in dist/",
    "build": "nest build && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "seed": "ts-node -r tsconfig-paths/register src/seeding/seed.cli.ts",
    "seed:prod": "node dist/seeding/seed.cli.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "//test": "runInBand + forceExit because the integration suite boots an ephemeral mongod",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --testPathIgnorePatterns=src/testing",
    "test:watch": "jest --watch",
    "test:cov": "jest --runInBand --forceExit --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "helmet": "^8.1.0",
    "mongoose": "^8.20.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.28",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.9",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@pyramid/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
